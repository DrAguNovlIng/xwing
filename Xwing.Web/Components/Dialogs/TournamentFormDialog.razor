@inject ITournamentStore TournamentStore
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">
            <MudTextField @bind-Value="name" Label="Name" Variant="Variant.Outlined" Required="true" />
            <MudDatePicker @bind-Date="startDate" Label="Start date" Variant="Variant.Outlined" Required="true" />
            <MudDatePicker @bind-Date="endDate" Label="End date" Variant="Variant.Outlined" Required="true" />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Tournament? Tournament { get; set; }
    private bool isCreate => Tournament is null;

    private string name = string.Empty;

    private DateTime? startDate;

    private DateTime? endDate;

    private string? errorMessage;

    protected override void OnParametersSet()
    {
        name = Tournament?.Name ?? string.Empty;
        startDate = Tournament is null ? null : Tournament.StartDateUtc.UtcDateTime.Date;
        endDate = Tournament is null ? null : Tournament.EndDateUtc.UtcDateTime.Date;
        errorMessage = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (startDate is null || endDate is null)
        {
            errorMessage = "Start and end dates are required.";
            return;
        }
        DateTimeOffset startDateUtc = ToUtcDate(startDate.Value);
        DateTimeOffset endDateUtc = ToUtcDate(endDate.Value);
        if (isCreate)
        {
            Result<Tournament> result = await TournamentStore.CreateAsync(
                name,
                startDateUtc,
                endDateUtc,
                CancellationToken.None);
            if (!result.IsSuccess)
            {
                errorMessage = result.Error;
                return;
            }
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Result<Tournament> updateResult = await TournamentStore.UpdateAsync(
            Tournament!.TournamentId,
            name,
            startDateUtc,
            endDateUtc,
            Tournament.RowVersion,
            CancellationToken.None);
        if (!updateResult.IsSuccess)
        {
            errorMessage = updateResult.Error;
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private static DateTimeOffset ToUtcDate(DateTime date) =>
        new(date.Date, TimeSpan.Zero);
}
