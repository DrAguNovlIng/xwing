@inherits LayoutComponentBase
<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Xwing</MudText>
        <MudSpacer />
        <MudButton Href="/settings" Variant="Variant.Text" Color="Color.Inherit">Settings</MudButton>
    </MudAppBar>
    <MudMainContent Class="px-4 pb-4" Style="padding-top: calc(var(--mud-appbar-height, 64px) + 16px);">
        @Body
    </MudMainContent>
</MudLayout>
