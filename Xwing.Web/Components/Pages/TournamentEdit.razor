    private static bool HasPendingResultChangesFor(TournamentMatch match, SidePanelSnapshot snapshot) =>
        snapshot.Status != match.Status
        || snapshot.PlayMode != match.PlayMode
        || !string.Equals(snapshot.ReplayUrl ?? string.Empty, match.ReplayUrl ?? string.Empty, StringComparison.Ordinal)
        || snapshot.SlotAUserId != match.SlotAUserId
        || snapshot.SlotBUserId != match.SlotBUserId
        || snapshot.SlotAPoints != match.SlotAPoints
        || snapshot.SlotBPoints != match.SlotBPoints
        || snapshot.Winner != match.Winner;
    private bool IsOutcomeAvailableForSlot(int sourceMatchId, TemplateFeedOutcome outcome, TemplateMatchSlot slot)
    {
        if (selectedMatch is null || graph is null)
        {
            return false;
        }
        TournamentMatchFeed? existing = graph.Feeds.SingleOrDefault(
            f => f.SourceTournamentMatchId == sourceMatchId && f.SourceOutcome == outcome);
        if (existing is null)
        {
            return true;
        }
        return existing.TargetTournamentMatchId == selectedMatch.TournamentMatchId && existing.TargetSlot == slot;
    }

    private string GetSlotSelectValue(TournamentMatch match, TemplateMatchSlot slot)
    {
        TournamentMatchFeed? feed = graph!.Feeds.SingleOrDefault(
            f => f.TargetTournamentMatchId == match.TournamentMatchId && f.TargetSlot == slot);
        if (feed is null)
        {
            return OpenSlotValue;
        }
        return feed.SourceOutcome == TemplateFeedOutcome.Winner
            ? WinnerSlotValue(feed.SourceTournamentMatchId)
            : LoserSlotValue(feed.SourceTournamentMatchId);
    }

    private static string WinnerSlotValue(int sourceMatchId) => $"w:{sourceMatchId}";
    private static string LoserSlotValue(int sourceMatchId) => $"l:{sourceMatchId}";
    private IEnumerable<TournamentMatch> OtherMatches(TournamentMatch match) =>
        graph!.Matches.Where(m => m.TournamentMatchId != match.TournamentMatchId);
    private static string DisplayName(TournamentMatch match) =>
        string.IsNullOrWhiteSpace(match.Name) ? $"Match {match.TournamentMatchId}" : match.Name!;
    private string ReplayUrlFieldLabel =>
        editStatus == TournamentMatchStatus.Finished ? "Replay URL" : "Match URL";
    private string FormatSlot(TournamentMatch match, TemplateMatchSlot slot)
    {
        int? userId = slot == TemplateMatchSlot.A ? match.SlotAUserId : match.SlotBUserId;
        int? points = slot == TemplateMatchSlot.A ? match.SlotAPoints : match.SlotBPoints;
        if (userId is int uid)
        {
            string name = graph!.Participants.FirstOrDefault(p => p.UserId == uid)?.UserName ?? $"User {uid}";
            string pointsText = points is int p ? $" ({p} pts)" : string.Empty;
            return $"{name}{pointsText}";
        }

        TournamentMatchFeed? feed = graph!.Feeds.SingleOrDefault(
            f => f.TargetTournamentMatchId == match.TournamentMatchId && f.TargetSlot == slot);
        if (feed is null)
        {
            string? label = slot == TemplateMatchSlot.A ? match.SlotAOpenLabel : match.SlotBOpenLabel;
            return string.IsNullOrWhiteSpace(label) ? "-" : label;
        }
        TournamentMatch? source = graph.Matches.SingleOrDefault(m => m.TournamentMatchId == feed.SourceTournamentMatchId);
        string sourceName = source is null ? "?" : DisplayName(source);
        return feed.SourceOutcome == TemplateFeedOutcome.Winner
            ? $"Winner of {sourceName}"
            : $"Loser of {sourceName}";
    }

    private string GetSlotLineClass(TournamentMatch match, TemplateMatchSlot slot)
    {
        const string baseClass = "slot-line";
        if (match.Winner == TournamentMatchWinner.SlotA && slot == TemplateMatchSlot.A)
        {
            return $"{baseClass} slot-outcome-winner";
        }

        if (match.Winner == TournamentMatchWinner.SlotB && slot == TemplateMatchSlot.B)
        {
            return $"{baseClass} slot-outcome-winner";
        }

        if (match.Winner == TournamentMatchWinner.SlotA && slot == TemplateMatchSlot.B)
        {
            return $"{baseClass} slot-outcome-loser";
        }

        if (match.Winner == TournamentMatchWinner.SlotB && slot == TemplateMatchSlot.A)
        {
            return $"{baseClass} slot-outcome-loser";
        }

        TournamentMatchFeed? feed = graph!.Feeds.SingleOrDefault(
            f => f.TargetTournamentMatchId == match.TournamentMatchId && f.TargetSlot == slot);
        if (feed is null)
        {
            return baseClass;
        }

        return feed.SourceOutcome == TemplateFeedOutcome.Winner
            ? $"{baseClass} slot-outcome-winner"
            : $"{baseClass} slot-outcome-loser";
    }

    private static string GetMatchStatusClass(TournamentMatch match) =>
        match.Status switch
        {
            TournamentMatchStatus.InProgress => "match-status-in-progress",
            TournamentMatchStatus.Finished => "match-status-finished",
            _ => string.Empty,
        };
    private string FormatPlayerSelect(int? userId) =>
        userId is null
            ? "-"
            : graph?.Participants.FirstOrDefault(p => p.UserId == userId)?.UserName ?? $"User {userId}";
    private string FormatStructureSlotSelect(string value)
    {
        if (value == OpenSlotValue)
        {
            return "Custom entrant";
        }

        if (TryParseSlotValue(value, out int? sourceId, out TemplateFeedOutcome? outcome) &&
            sourceId is not null &&
            outcome is not null &&
            graph is not null)
        {
            TournamentMatch? source = graph.Matches.FirstOrDefault(m => m.TournamentMatchId == sourceId);
            string sourceName = source is null ? "?" : DisplayName(source);
            return outcome == TemplateFeedOutcome.Winner
                ? $"Winner of {sourceName}"
                : $"Loser of {sourceName}";
        }

        return value;
    }

    private (double X, double Y) GetSourceAnchor(int sourceMatchId)
    {
        TournamentMatch match = graph!.Matches.Single(m => m.TournamentMatchId == sourceMatchId);
        double left = GetCellX(match) * CellSize + BoxOffset;
        double top = GetCellY(match) * CellSize + BoxOffset;
        return (left + BoxWidth, top + BoxHeight / 2);
    }

    private (double X, double Y) GetSlotAnchor(int targetMatchId, TemplateMatchSlot slot)
    {
        TournamentMatch match = graph!.Matches.Single(m => m.TournamentMatchId == targetMatchId);
        double left = GetCellX(match) * CellSize + BoxOffset;
        double top = GetCellY(match) * CellSize + BoxOffset;
        double slotY = slot == TemplateMatchSlot.A ? top + 28 : top + 56;
        return (left, slotY);
    }

    private void StartDrag(PointerEventArgs e, TournamentMatch match)
    {
        draggingMatchId = match.TournamentMatchId;
        dragCellX = match.PositionX;
        dragCellY = match.PositionY;
        activePointerId = e.PointerId;
    }

    private void OnSurfacePointerMove(PointerEventArgs e)
    {
        if (draggingMatchId is null || activePointerId != e.PointerId)
        {
            return;
        }
        int maxX = graph is null ? int.MaxValue : BracketGraphLayout.MaxMatchPositionX(graph.Tournament.GraphWidthCells);
        int maxY = graph is null ? int.MaxValue : BracketGraphLayout.MaxMatchPositionY(graph.Tournament.GraphHeightCells);
        int nextX = Math.Clamp((int)Math.Floor(e.OffsetX / CellSize), 0, maxX);
        int nextY = Math.Clamp((int)Math.Floor(e.OffsetY / CellSize), 0, maxY);
        if (nextX == dragCellX && nextY == dragCellY)
        {
            return;
        }
        dragCellX = nextX;
        dragCellY = nextY;
        StateHasChanged();
    }

    private async Task OnSurfacePointerUp(PointerEventArgs e)
    {
        if (draggingMatchId is null || activePointerId != e.PointerId)
        {
            return;
        }
        TournamentMatch? match = graph?.Matches.SingleOrDefault(m => m.TournamentMatchId == draggingMatchId);
        int savedX = dragCellX;
        int savedY = dragCellY;
        draggingMatchId = null;
        activePointerId = null;
        if (match is null)
        {
            return;
        }
        if (match.PositionX == savedX && match.PositionY == savedY)
        {
            return;
        }
        Result<TournamentMatch> result = await BracketStore.UpdateMatchPositionAsync(
            match.TournamentMatchId,
            savedX,
            savedY,
            match.RowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not save position.", Severity.Error);
        }
        await LoadGraphAsync();
    }

    private async Task AddMatchAsync()
    {
