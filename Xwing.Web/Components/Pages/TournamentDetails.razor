@page "/tournaments/{TournamentId:int}"

@attribute [Authorize]

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Xwing.Web.Components.Dialogs
@using Xwing.Web.Data
@inject ITournamentStore TournamentStore

@inject TimeProvider TimeProvider
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService

@implements IDisposable

<PageTitle>@(tournament?.Name ?? "Tournament")</PageTitle>

@if (loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (tournament is null)
{
    <MudText Typo="Typo.h5" Class="mb-2">Tournament not found</MudText>
    <MudButton Variant="Variant.Text" Href="/tournaments">Back to tournaments</MudButton>
}
else
{
    <div class="tournament-details-page">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/tournaments">
            Tournaments
        </MudButton>
    </MudStack>
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <MudAlert Severity="@statusSeverity" Class="mb-4" Dense="true">@statusMessage</MudAlert>
    }
    <MudText Typo="Typo.h4" Class="mb-2 tournament-details-title">@tournament.Name</MudText>
    @if (!string.IsNullOrEmpty(joinTimeLeftLabel))
    {
        <MudText Typo="Typo.body2"
                 Class="mb-4"
                 Color="@(joinTimeLeftUrgent ? Color.Error : Color.Default)">
            @joinTimeLeftLabel
        </MudText>
    }
    <div class="tournament-details-summary mb-4">
        <div class="tournament-details-facts">
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(tournament)">@GetStatusLabel(tournament)</MudChip>
            @if (tournament.UniqueFactions)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Unique factions</MudChip>
            }
            @if (currentUserJoined && CurrentUserHasSquad)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">Squad added</MudChip>
            }
            <div class="tournament-details-dates">
                <MudText Typo="Typo.body2">Start: @FormatDate(tournament.StartDateUtc)</MudText>
                <MudText Typo="Typo.body2">End: @FormatDate(tournament.EndDateUtc)</MudText>
            </div>
        </div>
        <div class="tournament-details-actions">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"/tournaments/{TournamentId}/results")">Results</MudButton>
            @if (isAdmin)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" Href="@($"/tournaments/{TournamentId}/edit")">Edit results</MudButton>
            }
        </div>
    </div>
    @if (currentUserJoined && !CurrentUserHasSquad)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            You have not added a squad yet.
        </MudAlert>
    }
    @if (rosterOpen)
    {
        <div class="tournament-details-roster-actions mb-4">
            @if (currentUserJoined)
            {
                <MudButton Variant="@(CurrentUserHasSquad ? Variant.Outlined : Variant.Filled)"
                           Color="@(CurrentUserHasSquad ? Color.Primary : Color.Warning)"
                           Disabled="actionInProgress"
                           OnClick="OpenSquadDialogAsync">
                    @(CurrentUserHasSquad ? "Change squad" : "Add squad")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="actionInProgress"
                           OnClick="ConfirmLeaveAsync">
                    Leave tournament
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="actionInProgress"
                           OnClick="JoinAsync">
                    Join tournament
                </MudButton>
            }
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">The roster is closed for this tournament.</MudText>
    }
    <MudText Typo="Typo.h6" Class="mb-2">Participants</MudText>
    @if (members.Count == 0)
    {
        <MudText>No one has joined yet.</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (TournamentMember member in members)
            {
                bool isCurrentUserMissingSquad = currentUserId == member.UserId &&
                                                 string.IsNullOrEmpty(member.SquadUrl);
                <MudPaper Class="@($"pa-3{(isCurrentUserMissingSquad ? " participant-card-missing-squad" : string.Empty)}")"
                          Elevation="0"
                          Outlined="true">
                    <div class="participant-header">
                        <MudText Typo="Typo.subtitle1">@member.UserName</MudText>
                        @if (!string.IsNullOrEmpty(member.SquadUrl))
                        {
                            <MudLink Href="@member.SquadUrl" Target="_blank">
                                View build
                            </MudLink>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(member.SquadFactionDisplay))
                    {
                        var factionThemeKey = GetFactionThemeKey(member.SquadFactionDisplay);
                        <div class="squad-faction-banner @(factionThemeKey is null ? "squad-faction-banner--plain" : null)"
                             data-faction="@factionThemeKey">
                            @if (GetFactionIconSlug(member.SquadFactionDisplay) is string factionSlug)
                            {
                                <i class="@($"xwing-miniatures-font xwing-miniatures-font-{factionSlug} squad-faction-icon")"
                                   aria-hidden="true"></i>
                            }
                            <MudText Typo="Typo.body2" Class="squad-faction-name">@member.SquadFactionDisplay</MudText>
                        </div>
                    }
                    @if (member.SquadShips.Count > 0)
                    {
                        <div class="squad-pilot-rows">
                            @foreach (SquadShipDisplay ship in member.SquadShips)
                            {
                                string shipSlug = GetShipIconSlug(ship.ShipId);
                                <div class="squad-pilot-row">
                                    <i class="@($"xwing-miniatures-ship xwing-miniatures-ship-{shipSlug}")"
                                       aria-hidden="true"></i>
                                    <MudText Typo="Typo.body2">@ship.PilotLabel</MudText>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </MudStack>
    }
    </div>
}

@code {
    [Parameter]
    public int TournamentId { get; set; }
    private Tournament? tournament;
    private IReadOnlyList<TournamentMember> members = [];
    private bool loading = true;
    private bool actionInProgress;
    private int? currentUserId;
    private bool isAdmin;
    private DateTimeOffset todayUtc;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private bool rosterOpen;
    private bool currentUserJoined;
    private string? joinTimeLeftLabel;
    private bool joinTimeLeftUrgent;
    private PeriodicTimer? countdownTimer;
    private CancellationTokenSource? countdownCts;
    protected override async Task OnParametersSetAsync()
    {
        await StopCountdownAsync();
        loading = true;
        statusMessage = null;
        todayUtc = TournamentSchedule.TodayUtc(TimeProvider);
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string? idClaim = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        currentUserId = int.TryParse(idClaim, CultureInfo.InvariantCulture, out int parsedId) ? parsedId : null;
        isAdmin = authState.User.IsInRole(UserRoles.Admin);
        tournament = await TournamentStore.GetAsync(TournamentId, CancellationToken.None);
        if (tournament is not null)
        {
            members = await TournamentStore.ListMembersAsync(
                TournamentId,
                currentUserId,
                CancellationToken.None);
            RefreshRosterState();
            currentUserJoined = currentUserId is int uid && members.Any(m => m.UserId == uid);
        }
        else
        {
            joinTimeLeftLabel = null;
            joinTimeLeftUrgent = false;
            rosterOpen = false;
        }
        loading = false;
        if (tournament is not null && TournamentSchedule.TimeLeftToJoinUsesMinuteRefresh(tournament, TimeProvider.GetUtcNow()))
        {
            StartCountdownTimer();
        }
    }

    public void Dispose()
    {
        countdownCts?.Cancel();
        countdownCts?.Dispose();
        countdownTimer?.Dispose();
    }

    private void RefreshRosterState()
    {
        if (tournament is null)
        {
            rosterOpen = false;
            joinTimeLeftLabel = null;
            joinTimeLeftUrgent = false;
            return;
        }
        todayUtc = TournamentSchedule.TodayUtc(TimeProvider);
        rosterOpen = TournamentSchedule.GetStatus(tournament, todayUtc) == TournamentLifecycleStatus.Upcoming;
        DateTimeOffset utcNow = TimeProvider.GetUtcNow();
        joinTimeLeftLabel = rosterOpen
            ? TournamentSchedule.FormatTimeLeftToJoin(tournament, utcNow)
            : null;
        joinTimeLeftUrgent = rosterOpen &&
                             joinTimeLeftLabel is not null &&
                             TournamentSchedule.TimeLeftToJoinUsesMinuteRefresh(tournament, utcNow);
        if (joinTimeLeftLabel is null)
        {
            rosterOpen = false;
            joinTimeLeftUrgent = false;
        }
    }

    private void StartCountdownTimer()
    {
        countdownCts = new CancellationTokenSource();
        countdownTimer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        _ = RunCountdownLoopAsync(countdownCts.Token);
    }

    private async Task StopCountdownAsync()
    {
        if (countdownCts is not null)
        {
            await countdownCts.CancelAsync();
            countdownCts.Dispose();
            countdownCts = null;
        }
        countdownTimer?.Dispose();
        countdownTimer = null;
    }

    private async Task RunCountdownLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (countdownTimer is not null && await countdownTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    RefreshRosterState();
                    StateHasChanged();
                });
                if (!rosterOpen || tournament is null ||
                    !TournamentSchedule.TimeLeftToJoinUsesMinuteRefresh(tournament, TimeProvider.GetUtcNow()))
                {
                    await StopCountdownAsync();
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Countdown stopped when the page is disposed or the roster closes.
        }
    }

    private bool CurrentUserHasSquad =>
        currentUserId is int uid &&
        members.Any(m => m.UserId == uid && !string.IsNullOrEmpty(m.SquadUrl));
    private async Task OpenSquadDialogAsync()
    {
        if (currentUserId is not int userId)
        {
            return;
        }
        var parameters = new DialogParameters<TournamentSquadDialog>
        {
            { x => x.TournamentId, TournamentId },
            { x => x.UserId, userId },
            { x => x.HasExistingSquad, CurrentUserHasSquad },
        };
        IDialogReference dialog = await DialogService.ShowAsync<TournamentSquadDialog>(
            string.Empty,
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        DialogResult? result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await ReloadMembersAsync();
            ShowStatus("Squad saved.", Severity.Success);
        }
    }

    private async Task ConfirmLeaveAsync()
    {
        IDialogReference dialog = await DialogService.ShowAsync<LeaveTournamentConfirmDialog>(
            string.Empty,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        DialogResult? result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LeaveAsync();
        }
    }

    private async Task JoinAsync()
    {
        if (currentUserId is not int userId || tournament is null)
        {
            return;
        }

        if (tournament.UniqueFactions)
        {
            await OpenJoinFactionDialogAsync(userId);
            return;
        }

        actionInProgress = true;
        statusMessage = null;
        Result result = await TournamentStore.JoinAsync(
            TournamentId,
            userId,
            factionDisplayName: null,
            CancellationToken.None);
        actionInProgress = false;
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error!, Severity.Error);
            return;
        }

        await ReloadMembersAsync();
        ShowStatus("You joined the tournament.", Severity.Success);
    }

    private async Task OpenJoinFactionDialogAsync(int userId)
    {
        IReadOnlyList<string> takenFactions = members
            .Where(m => !string.IsNullOrEmpty(m.SquadFactionDisplay))
            .Select(m => m.SquadFactionDisplay!)
            .ToList();
        var parameters = new DialogParameters<TournamentJoinFactionDialog>
        {
            { x => x.TournamentId, TournamentId },
            { x => x.UserId, userId },
            { x => x.TakenFactions, takenFactions },
        };
        IDialogReference dialog = await DialogService.ShowAsync<TournamentJoinFactionDialog>(
            string.Empty,
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        DialogResult? result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await ReloadMembersAsync();
            ShowStatus("You joined the tournament.", Severity.Success);
        }
    }

    private async Task LeaveAsync()
    {
        if (currentUserId is not int userId)
        {
            return;
        }
        actionInProgress = true;
        statusMessage = null;
        Result result = await TournamentStore.LeaveAsync(TournamentId, userId, CancellationToken.None);
        actionInProgress = false;
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error!, Severity.Error);
            return;
        }
        await ReloadMembersAsync();
        ShowStatus("You left the tournament.", Severity.Success);
    }

    private async Task ReloadMembersAsync()
    {
        members = await TournamentStore.ListMembersAsync(
            TournamentId,
            currentUserId,
            CancellationToken.None);
        currentUserJoined = currentUserId is int uid && members.Any(m => m.UserId == uid);
    }

    private TournamentLifecycleStatus GetLifecycleStatus(Tournament t) =>
        TournamentSchedule.GetStatus(t, todayUtc);
    private string GetStatusLabel(Tournament t) =>
        GetLifecycleStatus(t) switch
        {
            TournamentLifecycleStatus.Upcoming => "Upcoming",
            TournamentLifecycleStatus.InProgress => "In progress",
            _ => "Past",
        };
    private Color GetStatusColor(Tournament t) =>
        GetLifecycleStatus(t) switch
        {
            TournamentLifecycleStatus.Upcoming => Color.Info,
            TournamentLifecycleStatus.InProgress => Color.Success,
            _ => Color.Error,
        };
    private static string FormatDate(DateTimeOffset value) =>
        value.UtcDateTime.ToString("d", CultureInfo.CurrentCulture);
    private static string? GetFactionThemeKey(string factionDisplayName) =>
        XwaSquad.GetFactionThemeKey(factionDisplayName);
    private static string? GetFactionIconSlug(string factionDisplayName) =>
        XwaSquad.GetFactionIconSlug(factionDisplayName);
    private static string GetShipIconSlug(string shipId) =>
        XwaSquad.GetShipIconSlug(shipId);
    private void ShowStatus(string message, Severity severity)
    {
        statusMessage = message;
        statusSeverity = severity;
    }
}
