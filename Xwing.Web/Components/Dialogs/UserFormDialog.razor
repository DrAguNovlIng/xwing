@inject IUserStore UserStore
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">
            <MudTextField @bind-Value="userName" Label="Username" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="password"
                           Label="@passwordLabel"
                           InputType="InputType.Password"
                           Variant="Variant.Outlined"
                           Required="@isCreate" />
            <MudSelect T="string" @bind-Value="role" Label="Role" Variant="Variant.Outlined" Required="true" Disabled="roleSelectDisabled">
                @foreach (string option in UserRoles.All)
                {
                    <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                }
            </MudSelect>
            @if (roleSelectDisabled)
            {
                <MudText Typo="Typo.caption">You cannot change your own role.</MudText>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserAccount? User { get; set; }
    [Parameter]
    public int? CurrentUserId { get; set; }
    private bool isCreate => User is null;

    private string userName = string.Empty;

    private string password = string.Empty;

    private string role = UserRoles.Member;

    private string? errorMessage;

    private string passwordLabel => isCreate ? "Password" : "New password (leave blank to keep)";

    private bool roleSelectDisabled => !isCreate && User is not null && CurrentUserId == User.UserId;

    protected override void OnParametersSet()
    {
        if (User is null)
        {
            userName = string.Empty;
            password = string.Empty;
            role = UserRoles.Member;
        }
        else
        {
            userName = User.UserName;
            password = string.Empty;
            role = User.Role;
        }
        errorMessage = null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (isCreate)
        {
            Result<UserAccount> result = await UserStore.CreateAsync(
                userName,
                password,
                role,
                CancellationToken.None);
            if (!result.IsSuccess)
            {
                errorMessage = result.Error;
                return;
            }
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }
        Result<UserAccount> updateResult = await UserStore.UpdateAsync(
            User!.UserId,
            userName,
            string.IsNullOrWhiteSpace(password) ? null : password,
            role,
            User.RowVersion,
            CurrentUserId,
            CancellationToken.None);
        if (!updateResult.IsSuccess)
        {
            errorMessage = updateResult.Error;
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }
}
