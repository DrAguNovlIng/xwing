@page "/tournaments/{TournamentId:int}/edit"

@attribute [Authorize(Roles = UserRoles.Admin)]

@using Xwing.Web.Data
@using Xwing.Web.Components.Dialogs
@using Xwing.Web.Models
@using Xwing.Web.Stores
@inject ITournamentBracketStore BracketStore
@inject ITournamentTemplateStore TemplateStore
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@pageTitle</PageTitle>

<MudStack Spacing="2">
    <MudToolBar Gutters="false" WrapContent="true">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Variant="Variant.Text"
                   OnClick="@(() => Navigation.NavigateTo($"/tournaments/{TournamentId}"))">
            Tournament
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(graph is null)"
                   OnClick="AddMatchAsync">
            Add match
        </MudButton>
    </MudToolBar>
    <MudText Typo="Typo.h5">@pageTitle</MudText>
    @if (graph is not null)
    {
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-2 bracket-inline-controls">
            <MudSelect T="int?"
                       Label="Apply template"
                       Variant="Variant.Outlined"
                       Value="selectedTemplateId"
                       ValueChanged="OnTemplateSelectedAsync"
                       Style="min-width: 16rem;">
                <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                @foreach (TournamentTemplate template in templates)
                {
                    <MudSelectItem T="int?" Value="@template.TournamentTemplateId">@template.Name</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.End" Class="bracket-inline-controls">
                <MudNumericField T="int"
                                 @bind-Value="editGraphWidthCells"
                                 @bind-Value:after="SaveGraphSizeAsync"
                                 Label="Canvas width (cells)"
                                 Variant="Variant.Outlined"
                                 Min="@BracketGraphLayout.MinGraphCells"
                                 Max="@BracketGraphLayout.MaxGraphCells"
                                 Style="max-width: 10rem;" />
                <MudNumericField T="int"
                                 @bind-Value="editGraphHeightCells"
                                 @bind-Value:after="SaveGraphSizeAsync"
                                 Label="Canvas height (cells)"
                                 Variant="Variant.Outlined"
                                 Min="@BracketGraphLayout.MinGraphCells"
                                 Max="@BracketGraphLayout.MaxGraphCells"
                                 Style="max-width: 10rem;" />
            </MudStack>
        </MudStack>
    }
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <MudAlert Severity="@statusSeverity" Dense="true">@statusMessage</MudAlert>
    }
    @if (graph is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <TournamentStandingsPanel Participants="graph.Participants" Matches="graph.Matches" />
        <div class="bracket-editor-stage">
                <div class="template-graph-surface @(draggingMatchId is not null ? "template-graph-surface-dragging" : string.Empty)"
                     style="@SurfaceStyle"
                     @onpointermove="OnSurfacePointerMove"
                     @onpointerup="OnSurfacePointerUp"
                     @onpointercancel="OnSurfacePointerUp">
                    <svg class="template-graph-edges"
                         width="@surfaceWidth"
                         height="@surfaceHeight"
                         xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="template-edge-winner"
                                    markerWidth="8"
                                    markerHeight="8"
                                    refX="7"
                                    refY="4"
                                    orient="auto"
                                    markerUnits="strokeWidth">
                                <path d="M0,0 L8,4 L0,8 Z" fill="var(--mud-palette-success)" />
                            </marker>
                            <marker id="template-edge-loser"
                                    markerWidth="8"
                                    markerHeight="8"
                                    refX="7"
                                    refY="4"
                                    orient="auto"
                                    markerUnits="strokeWidth">
                                <path d="M0,0 L8,4 L0,8 Z" fill="var(--mud-palette-warning)" />
                            </marker>
                        </defs>
                        @foreach (TournamentMatchFeed feed in graph.Feeds)
                        {
                            (double x1, double y1) = GetSourceAnchor(feed.SourceTournamentMatchId);
                            (double x2, double y2) = GetSlotAnchor(feed.TargetTournamentMatchId, feed.TargetSlot);
                            bool isWinner = feed.SourceOutcome == TemplateFeedOutcome.Winner;
                            string strokeColor = isWinner
                                ? "var(--mud-palette-success)"
                                : "var(--mud-palette-warning)";
                            string markerEnd = isWinner
                                ? "url(#template-edge-winner)"
                                : "url(#template-edge-loser)";
                            <line x1="@x1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  y1="@y1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  x2="@x2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  y2="@y2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  stroke="@strokeColor"
                                  stroke-width="2.5"
                                  marker-end="@markerEnd" />
                        }
                    </svg>
                    @foreach (TournamentMatch match in graph.Matches)
                    {
                        bool isDragging = draggingMatchId == match.TournamentMatchId;
                        if (isDragging)
                        {
                            <div class="template-match-box template-match-box-ghost"
                                 style="@GetBoxStyle(match.PositionX, match.PositionY)">
                                <div class="template-match-drag-handle">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    <div class="template-match-box-header">
                                        <MudText Typo="Typo.subtitle2">@DisplayName(match)</MudText>
                                        @if (match.PlayMode == TournamentMatchPlayMode.Online)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">Online</MudChip>
                                        }
                                    </div>
                                </div>
                                <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.A)">A: @FormatSlot(match, TemplateMatchSlot.A)</MudText>
                                <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.B)">B: @FormatSlot(match, TemplateMatchSlot.B)</MudText>
                            </div>
                        }
                        int displayX = isDragging ? dragCellX : match.PositionX;
                        int displayY = isDragging ? dragCellY : match.PositionY;
                        <div class="template-match-box @GetMatchStatusClass(match) @(selectedMatch?.TournamentMatchId == match.TournamentMatchId ? "selected" : string.Empty) @(isDragging ? "dragging" : string.Empty)"
                             style="@GetBoxStyle(displayX, displayY)"
                             @onpointerdown="@(async _ => await SelectMatchAsync(match))"
                             @onpointerdown:stopPropagation="true">
                            <div class="template-match-drag-handle"
                                 @onpointerdown="@(e => StartDrag(e, match))"
                                 @onpointerdown:stopPropagation="true">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                <div class="template-match-box-header">
                                    <MudText Typo="Typo.subtitle2">@DisplayName(match)</MudText>
                                    @if (match.PlayMode == TournamentMatchPlayMode.Online)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Online</MudChip>
                                    }
                                </div>
                            </div>
                            <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.A)">A: @FormatSlot(match, TemplateMatchSlot.A)</MudText>
                            <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.B)">B: @FormatSlot(match, TemplateMatchSlot.B)</MudText>
                        </div>
                    }
                </div>
            @if (selectedMatch is not null && matchEditorOpen)
            {
                    <MudPaper Class="pa-4 bracket-match-editor-panel" Elevation="4">
                        <div class="bracket-match-editor-panel-header">
                            <MudText Typo="Typo.h6">Match</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           aria-label="Close match editor"
                                           OnClick="CloseMatchEditor" />
                        </div>
                        <div @onfocusin="OnMatchNameFocus">
                            <MudTextField @bind-Value="editMatchName"
                                          Label="Name"
                                          Variant="Variant.Outlined"
                                          Class="mb-3"
                                          Immediate="true"
                                          OnBlur="OnMatchNameBlurAsync" />
                        </div>
                        <MudNumericField T="int?"
                                         Value="editRoundNumber"
                                         ValueChanged="OnEditRoundChangedAsync"
                                         Label="Round"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Class="mb-4" />
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Results</MudText>
                        <MudSelect T="TournamentMatchStatus"
                                   Value="editStatus"
                                   ValueChanged="OnEditStatusChangedAsync"
                                   Label="Status"
                                   Variant="Variant.Outlined"
                                   Class="mb-2">
                            <MudSelectItem Value="TournamentMatchStatus.NotStarted">Not started</MudSelectItem>
                            <MudSelectItem Value="TournamentMatchStatus.InProgress">In progress</MudSelectItem>
                            <MudSelectItem Value="TournamentMatchStatus.Finished">Finished</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="TournamentMatchPlayMode"
                                   Value="editPlayMode"
                                   ValueChanged="OnEditPlayModeChangedAsync"
                                   Label="Play mode"
                                   Variant="Variant.Outlined"
                                   Class="mb-2">
                            <MudSelectItem Value="TournamentMatchPlayMode.Offline">Offline</MudSelectItem>
                            <MudSelectItem Value="TournamentMatchPlayMode.Online">Online</MudSelectItem>
                        </MudSelect>
                        <div @onfocusin="OnReplayUrlFocus">
                            <MudTextField @bind-Value="editReplayUrl"
                                          Label="@ReplayUrlFieldLabel"
                                          Variant="Variant.Outlined"
                                          Class="mb-2"
                                          Immediate="true"
                                          OnBlur="OnReplayUrlBlurAsync" />
                        </div>
                        <MudSelect T="int?"
                                   Label="Slot A player"
                                   Variant="Variant.Outlined"
                                   Value="editSlotAUserId"
                                   ValueChanged="OnEditSlotAUserChangedAsync"
                                   ToStringFunc="FormatPlayerSelect"
                                   Class="mb-2">
                            <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                            @foreach (TournamentBracketParticipant player in AssignablePlayers(selectedMatch))
                            {
                                <MudSelectItem T="int?" Value="@player.UserId">@player.UserName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="int?"
                                         Value="editSlotAPoints"
                                         ValueChanged="OnEditSlotAPointsChangedAsync"
                                         Label="Slot A points"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Class="mb-2" />
                        <MudSelect T="int?"
                                   Label="Slot B player"
                                   Variant="Variant.Outlined"
                                   Value="editSlotBUserId"
                                   ValueChanged="OnEditSlotBUserChangedAsync"
                                   ToStringFunc="FormatPlayerSelect"
                                   Class="mb-2">
                            <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                            @foreach (TournamentBracketParticipant player in AssignablePlayers(selectedMatch))
                            {
                                <MudSelectItem T="int?" Value="@player.UserId">@player.UserName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="int?"
                                         Value="editSlotBPoints"
                                         ValueChanged="OnEditSlotBPointsChangedAsync"
                                         Label="Slot B points"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Class="mb-2" />
                        <MudSelect T="TournamentMatchWinner"
                                   Value="editWinner"
                                   ValueChanged="OnEditWinnerChangedAsync"
                                   Label="Winner"
                                   Variant="Variant.Outlined"
                                   Class="mb-4">
                            <MudSelectItem Value="TournamentMatchWinner.None">Neither</MudSelectItem>
                            <MudSelectItem Value="TournamentMatchWinner.SlotA">Slot A</MudSelectItem>
                            <MudSelectItem Value="TournamentMatchWinner.SlotB">Slot B</MudSelectItem>
                        </MudSelect>
                        <MudDivider Class="my-3" />
                        <MudSelect T="string"
                                   Label="Slot A"
                                   Variant="Variant.Outlined"
                                   Value="@slotAValue"
                                   ValueChanged="OnSlotAChangedAsync"
                                   ToStringFunc="FormatStructureSlotSelect"
                                   Class="mb-2">
                            <MudSelectItem T="string" Value="@OpenSlotValue">Custom entrant</MudSelectItem>
                            @foreach (TournamentMatch other in OtherMatches(selectedMatch))
                            {
                                if (IsOutcomeAvailableForSlot(other.TournamentMatchId, TemplateFeedOutcome.Winner, TemplateMatchSlot.A))
                                {
                                    <MudSelectItem T="string" Value="@WinnerSlotValue(other.TournamentMatchId)">Winner of @DisplayName(other)</MudSelectItem>
                                }
                                if (IsOutcomeAvailableForSlot(other.TournamentMatchId, TemplateFeedOutcome.Loser, TemplateMatchSlot.A))
                                {
                                    <MudSelectItem T="string" Value="@LoserSlotValue(other.TournamentMatchId)">Loser of @DisplayName(other)</MudSelectItem>
                                }
                            }
                        </MudSelect>
                        @if (slotAValue == OpenSlotValue)
                        {
                            <div @onfocusin="OnSlotAOpenLabelFocus">
                                <MudTextField @bind-Value="editSlotAOpenLabel"
                                              Label="Slot A entrant text"
                                              Variant="Variant.Outlined"
                                              Class="mb-3"
                                              OnBlur="OnSlotAOpenLabelBlurAsync" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3" />
                        }
                        <MudSelect T="string"
                                   Label="Slot B"
                                   Variant="Variant.Outlined"
                                   Value="@slotBValue"
                                   ValueChanged="OnSlotBChangedAsync"
                                   ToStringFunc="FormatStructureSlotSelect"
                                   Class="mb-2">
                            <MudSelectItem T="string" Value="@OpenSlotValue">Custom entrant</MudSelectItem>
                            @foreach (TournamentMatch other in OtherMatches(selectedMatch))
                            {
                                if (IsOutcomeAvailableForSlot(other.TournamentMatchId, TemplateFeedOutcome.Winner, TemplateMatchSlot.B))
                                {
                                    <MudSelectItem T="string" Value="@WinnerSlotValue(other.TournamentMatchId)">Winner of @DisplayName(other)</MudSelectItem>
                                }
                                if (IsOutcomeAvailableForSlot(other.TournamentMatchId, TemplateFeedOutcome.Loser, TemplateMatchSlot.B))
                                {
                                    <MudSelectItem T="string" Value="@LoserSlotValue(other.TournamentMatchId)">Loser of @DisplayName(other)</MudSelectItem>
                                }
                            }
                        </MudSelect>
                        @if (slotBValue == OpenSlotValue)
                        {
                            <div @onfocusin="OnSlotBOpenLabelFocus">
                                <MudTextField @bind-Value="editSlotBOpenLabel"
                                              Label="Slot B entrant text"
                                              Variant="Variant.Outlined"
                                              Class="mb-4"
                                              OnBlur="OnSlotBOpenLabelBlurAsync" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-4" />
                        }
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   FullWidth="true"
                                   OnClick="DeleteSelectedMatchAsync">
                            Delete match
                        </MudButton>
                    </MudPaper>
            }
        </div>
    }
</MudStack>

<style>
    .template-graph-surface {
        position: relative;
        box-sizing: content-box;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
        background-color: var(--mud-palette-background-gray);
        background-image:
            linear-gradient(to right, color-mix(in srgb, var(--mud-palette-lines-default) 35%, transparent) 1px, transparent 1px),
            linear-gradient(to bottom, color-mix(in srgb, var(--mud-palette-lines-default) 35%, transparent) 1px, transparent 1px);
        background-size: 40px 40px;
        overflow: clip;
        align-self: flex-start;
    }

    .template-graph-surface-dragging .template-match-box:not(.template-match-box-ghost) {
        pointer-events: none;
    }

    .template-graph-surface-dragging .template-match-drag-handle {
        cursor: grabbing;
    }

    .template-graph-edges {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .template-match-box {
        position: absolute;
        width: 168px;
        padding: 4px 8px 8px;
        border-radius: 4px;
        border: 2px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
        cursor: pointer;
        user-select: none;
        touch-action: none;
        z-index: 1;
    }

    .template-match-box.selected {
        border-color: var(--mud-palette-primary);
    }

    .template-match-box.dragging {
        z-index: 2;
        box-shadow: 0 4px 12px color-mix(in srgb, var(--mud-palette-text-primary) 25%, transparent);
    }

    .template-match-box-ghost {
        opacity: 0.35;
        border-style: dashed;
        pointer-events: none;
        z-index: 0;
        cursor: default;
    }

    .template-match-drag-handle {
        display: flex;
        align-items: center;
        gap: 4px;
        cursor: grab;
        margin-bottom: 4px;
    }

    .slot-line {
        display: block;
        line-height: 1.3;
    }
</style>

@code {
    private const int CellSize = 40;
    private const int BoxOffset = 6;
    private const int BoxWidth = 168;
    private const int BoxHeight = 88;
    private const string OpenSlotValue = "open";
    private int editGraphWidthCells;
    private int editGraphHeightCells;
    [Parameter]
    public int TournamentId { get; set; }
    private TournamentBracketGraph? graph;
    private TournamentMatch? selectedMatch;
    private bool matchEditorOpen;
    private string editMatchName = string.Empty;
    private string slotAValue = OpenSlotValue;
    private string slotBValue = OpenSlotValue;
    private string editSlotAOpenLabel = string.Empty;
    private string editSlotBOpenLabel = string.Empty;
    private int? editRoundNumber;
    private TournamentMatchStatus editStatus = TournamentMatchStatus.NotStarted;
    private TournamentMatchPlayMode editPlayMode = TournamentMatchPlayMode.Offline;
    private string? editReplayUrl;
    private int? editSlotAUserId;
    private int? editSlotBUserId;
    private int? editSlotAPoints;
    private int? editSlotBPoints;
    private TournamentMatchWinner editWinner = TournamentMatchWinner.None;
    private IReadOnlyList<TournamentTemplate> templates = [];
    private int? selectedTemplateId;
    private string pageTitle = "Tournament";
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private int? draggingMatchId;
    private int dragCellX;
    private int dragCellY;
    private long? activePointerId;
    private int? _boundMatchId;
    private int? _nameFocusMatchId;
    private int? _replayFocusMatchId;
    private int? _slotAOpenLabelFocusMatchId;
    private int? _slotBOpenLabelFocusMatchId;
    protected override async Task OnParametersSetAsync()
    {
        templates = await TemplateStore.ListAsync(CancellationToken.None);
        await LoadGraphAsync();
    }

    private async Task LoadGraphAsync()
    {
        Result<TournamentBracketGraph> result = await BracketStore.GetGraphAsync(TournamentId, CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Template not found.", Severity.Error);
            graph = null;
            return;
        }
        graph = result.Value!;
        pageTitle = graph.Tournament.Name;
        selectedTemplateId = graph.Tournament.TournamentTemplateId;
        editGraphWidthCells = graph.Tournament.GraphWidthCells;
        editGraphHeightCells = graph.Tournament.GraphHeightCells;
        if (selectedMatch is not null)
        {
            selectedMatch = graph.Matches.FirstOrDefault(m => m.TournamentMatchId == selectedMatch.TournamentMatchId);
            SyncSidePanel();
        }
    }

    private int surfaceWidth => graph is null
        ? BracketGraphLayout.ToSurfacePixels(BracketGraphLayout.DefaultGraphWidthCells)
        : BracketGraphLayout.ToSurfacePixels(graph.Tournament.GraphWidthCells);
    private int surfaceHeight => graph is null
        ? BracketGraphLayout.ToSurfacePixels(BracketGraphLayout.DefaultGraphHeightCells)
        : BracketGraphLayout.ToSurfacePixels(graph.Tournament.GraphHeightCells);
    private string SurfaceStyle => $"width: {surfaceWidth}px; height: {surfaceHeight}px; max-width: {surfaceWidth}px;";
    private int GetCellX(TournamentMatch match) =>
        draggingMatchId == match.TournamentMatchId ? dragCellX : match.PositionX;
    private int GetCellY(TournamentMatch match) =>
        draggingMatchId == match.TournamentMatchId ? dragCellY : match.PositionY;
    private static string GetBoxStyle(int cellX, int cellY) =>
        $"left: {cellX * CellSize + BoxOffset}px; top: {cellY * CellSize + BoxOffset}px;";
    private async Task SelectMatchAsync(TournamentMatch match)
    {
        if (draggingMatchId is not null)
        {
            return;
        }

        if (selectedMatch?.TournamentMatchId == match.TournamentMatchId)
        {
            matchEditorOpen = !matchEditorOpen;
            return;
        }

        if (_boundMatchId is int previousId && previousId != match.TournamentMatchId)
        {
            SidePanelSnapshot snapshot = CaptureSidePanelSnapshot();
            ClearFieldFocusMatchIds();
            await ApplySidePanelSnapshotAsync(previousId, snapshot);
        }

        selectedMatch = match;
        matchEditorOpen = true;
        SyncSidePanel();
    }

    private void CloseMatchEditor() => matchEditorOpen = false;
    private void SyncSidePanel()
    {
        if (selectedMatch is null || graph is null)
        {
            _boundMatchId = null;
            return;
        }

        editMatchName = selectedMatch.Name ?? string.Empty;
        slotAValue = GetSlotSelectValue(selectedMatch, TemplateMatchSlot.A);
        slotBValue = GetSlotSelectValue(selectedMatch, TemplateMatchSlot.B);
        editSlotAOpenLabel = selectedMatch.SlotAOpenLabel ?? string.Empty;
        editSlotBOpenLabel = selectedMatch.SlotBOpenLabel ?? string.Empty;
        editRoundNumber = selectedMatch.RoundNumber;
        editStatus = selectedMatch.Status;
        editPlayMode = selectedMatch.PlayMode;
        editReplayUrl = selectedMatch.ReplayUrl;
        editSlotAUserId = selectedMatch.SlotAUserId;
        editSlotBUserId = selectedMatch.SlotBUserId;
        editSlotAPoints = selectedMatch.SlotAPoints;
        editSlotBPoints = selectedMatch.SlotBPoints;
        editWinner = selectedMatch.Winner;
        _boundMatchId = selectedMatch.TournamentMatchId;
    }

    private sealed record SidePanelSnapshot(
        string MatchName,
        int? RoundNumber,
        TournamentMatchStatus Status,
        TournamentMatchPlayMode PlayMode,
        string? ReplayUrl,
        int? SlotAUserId,
        int? SlotBUserId,
        int? SlotAPoints,
        int? SlotBPoints,
        TournamentMatchWinner Winner,
        string SlotAValue,
        string SlotBValue,
        string SlotAOpenLabel,
        string SlotBOpenLabel);
    private SidePanelSnapshot CaptureSidePanelSnapshot() =>
        new(
            editMatchName,
            editRoundNumber,
            editStatus,
            editPlayMode,
            editReplayUrl,
            editSlotAUserId,
            editSlotBUserId,
            editSlotAPoints,
            editSlotBPoints,
            editWinner,
            slotAValue,
            slotBValue,
            editSlotAOpenLabel,
            editSlotBOpenLabel);
    private TournamentMatch? FindMatchById(int matchId) =>
        graph?.Matches.FirstOrDefault(m => m.TournamentMatchId == matchId);
    private async Task ApplySidePanelSnapshotAsync(int matchId, SidePanelSnapshot snapshot)
    {
        TournamentMatch? match = FindMatchById(matchId);
        if (match is null)
        {
            return;
        }

        await SaveMatchNameForAsync(match, snapshot.MatchName);
        match = FindMatchById(matchId);
        if (match is null)
        {
            return;
        }

        await SaveMatchRoundForAsync(match, snapshot.RoundNumber);
        match = FindMatchById(matchId);
        if (match is null)
        {
            return;
        }

        await SaveMatchResultForAsync(match, snapshot);
        match = FindMatchById(matchId);
        if (match is null)
        {
            return;
        }

        if (snapshot.SlotAValue == OpenSlotValue)
        {
            await SaveSlotOpenLabelForAsync(match, TemplateMatchSlot.A, snapshot.SlotAOpenLabel);
            match = FindMatchById(matchId);
        }

        if (match is not null && snapshot.SlotBValue == OpenSlotValue)
        {
            await SaveSlotOpenLabelForAsync(match, TemplateMatchSlot.B, snapshot.SlotBOpenLabel);
        }
    }

    private IEnumerable<TournamentBracketParticipant> AssignablePlayers(TournamentMatch match)
    {
        if (graph is null)
        {
            return [];
        }

        return graph.Participants.Where(p =>
            p.IsActive || p.UserId == match.SlotAUserId || p.UserId == match.SlotBUserId);
    }

    private async Task OnTemplateSelectedAsync(int? templateId)
    {
        if (templateId is null)
        {
            selectedTemplateId = null;
            return;
        }

        if (graph?.Matches.Count > 0)
        {
            IDialogReference dialog = await DialogService.ShowAsync<ReplaceBracketConfirmDialog>();
            DialogResult? dialogResult = await dialog.Result;
            if (dialogResult is null || dialogResult.Canceled)
            {
                selectedTemplateId = graph?.Tournament.TournamentTemplateId;
                return;
            }
        }

        Result result = await BracketStore.AssignTemplateAsync(TournamentId, templateId.Value, CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not apply template.", Severity.Error);
            selectedTemplateId = graph?.Tournament.TournamentTemplateId;
            return;
        }

        selectedTemplateId = templateId;
        selectedMatch = null;
        ShowStatus("Template applied.", Severity.Success);
        await LoadGraphAsync();
    }

    private Task saveGraphSizeQueue = Task.CompletedTask;
    private Task SaveGraphSizeAsync()
    {
        saveGraphSizeQueue = SaveNextGraphSizeAsync(saveGraphSizeQueue);
        return saveGraphSizeQueue;
    }

    private async Task SaveNextGraphSizeAsync(Task previous)
    {
        try
        {
            await previous;
        }
        catch (Exception)
        {
            // The previous attempt already reported its own error.
        }

        if (graph is null
            || (editGraphWidthCells == graph.Tournament.GraphWidthCells
                && editGraphHeightCells == graph.Tournament.GraphHeightCells))
        {
            return;
        }

        int widthCells = editGraphWidthCells;
        int heightCells = editGraphHeightCells;
        int previousWidthCells = graph.Tournament.GraphWidthCells;
        int previousHeightCells = graph.Tournament.GraphHeightCells;
        byte[] rowVersion = graph.Tournament.RowVersion;
        graph.Tournament.GraphWidthCells = widthCells;
        graph.Tournament.GraphHeightCells = heightCells;
        Result<Tournament> result = await BracketStore.UpdateGraphSizeAsync(
            TournamentId,
            widthCells,
            heightCells,
            rowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            graph.Tournament.GraphWidthCells = previousWidthCells;
            graph.Tournament.GraphHeightCells = previousHeightCells;
            editGraphWidthCells = previousWidthCells;
            editGraphHeightCells = previousHeightCells;
            ShowStatus(result.Error ?? "Could not save canvas size.", Severity.Error);
            return;
        }

        graph.Tournament.RowVersion = result.Value!.RowVersion;
        if (statusSeverity == Severity.Error)
        {
            statusMessage = null;
        }
    }

