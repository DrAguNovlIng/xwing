@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IUserStore UserStore
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">Xwing</MudText>
        <MudSpacer />
        @if (isSignedIn)
        {
            <MudText Class="mr-2">@userName</MudText>
            <form method="post" action="/account/logout" class="d-inline">
                <AntiforgeryFormField />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Logout</MudButton>
            </form>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            @if (isSignedIn)
            {
                <MudNavLink Href="/tournaments" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EmojiEvents">Tournaments</MudNavLink>
                <MudNavLink Href="/print-squads" Icon="@Icons.Material.Filled.Print">Print squads</MudNavLink>
            }

            @if (isAdmin)
            {
                <MudNavLink Href="/tournaments/manage" Icon="@Icons.Material.Filled.Edit">Manage tournaments</MudNavLink>
                <MudNavLink Href="/tournament-templates" Icon="@Icons.Material.Filled.AccountTree">Tournament templates</MudNavLink>
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            }
            else if (showUsersNav)
            {
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            }

            @if (!isSignedIn && showLoginNav)
            {
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
            }
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="px-4 pb-4" Style="padding-top: calc(var(--mud-appbar-height, 64px) + 16px);">
        @Body
    </MudMainContent>
</MudLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool isSignedIn;
    private bool isAdmin;
    private bool showLoginNav;
    private bool showUsersNav;
    private string userName = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        showUsersNav = !await UserStore.AnyAdminExistsAsync(CancellationToken.None);
        showLoginNav = !showUsersNav;
        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isSignedIn = authState.User.Identity?.IsAuthenticated == true;
        isAdmin = authState.User.IsInRole(UserRoles.Admin);
        userName = authState.User.Identity?.Name ?? string.Empty;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
