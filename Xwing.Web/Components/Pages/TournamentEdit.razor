@page "/tournaments/{TournamentId:int}/edit"

@attribute [Authorize(Roles = UserRoles.Admin)]

@using Microsoft.JSInterop
@using Xwing.Web.Data
@using Xwing.Web.Components
@using Xwing.Web.Components.Dialogs
@using Xwing.Web.Models
@using Xwing.Web.Stores
@inject ITournamentBracketStore BracketStore
@inject ITournamentTemplateStore TemplateStore
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@pageTitle</PageTitle>

<MudStack Spacing="2">
    <MudToolBar Gutters="false" WrapContent="true">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Variant="Variant.Text"
                   OnClick="@(() => Navigation.NavigateTo($"/tournaments/{TournamentId}"))">
            Tournament
        </MudButton>
        <MudSpacer />
    </MudToolBar>
    <MudText Typo="Typo.h5">@pageTitle</MudText>
    @if (graph is not null)
    {
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2 bracket-inline-controls bracket-editor-toolbar">
            <MudSelect T="int?"
                       Label="Apply template"
                       Variant="Variant.Outlined"
                       Value="selectedTemplateId"
                       ValueChanged="OnTemplateSelectedAsync"
                       Style="min-width: 16rem;">
                <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                @foreach (TournamentTemplate template in templates)
                {
                    <MudSelectItem T="int?" Value="@template.TournamentTemplateId">@template.Name</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int"
                             @bind-Value="editGraphWidthCells"
                             @bind-Value:after="SaveGraphSizeAsync"
                             Label="Canvas width (cells)"
                             Variant="Variant.Outlined"
                             Min="@BracketGraphLayout.MinGraphCells"
                             Max="@BracketGraphLayout.MaxGraphCells"
                             Style="max-width: 10rem;" />
            <MudNumericField T="int"
                             @bind-Value="editGraphHeightCells"
                             @bind-Value:after="SaveGraphSizeAsync"
                             Label="Canvas height (cells)"
                             Variant="Variant.Outlined"
                             Min="@BracketGraphLayout.MinGraphCells"
                             Max="@BracketGraphLayout.MaxGraphCells"
                             Style="max-width: 10rem;" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="bracket-inline-action"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddMatchAsync">
                Add match
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="bracket-inline-action"
                       StartIcon="@Icons.Material.Filled.ViewColumn"
                       OnClick="AddRoundAsync">
                Add round
            </MudButton>
            <MudCheckBox @bind-Value="allowLayoutDrag"
                         @bind-Value:after="OnAllowLayoutDragChangedAsync"
                         Label="Enable dragging (move matches, resize rounds)"
                         Color="Color.Primary"
                         Class="bracket-inline-action bracket-inline-action--checkbox" />
        </MudStack>
    }
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <MudAlert Severity="@statusSeverity" Dense="true">@statusMessage</MudAlert>
    }
    @if (graph is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <TournamentStandingsPanel Participants="graph.Participants" Matches="graph.Matches" />
        <div class="bracket-editor-stage">
            <BracketRoundCanvas @ref="bracketRoundCanvasRef"
                                SurfaceWidth="@surfaceWidth"
                                SurfaceHeight="@surfaceHeight"
                                GraphWidthCells="@graph.Tournament.GraphWidthCells"
                                Editable="true"
                                AllowColumnResize="@allowLayoutDrag"
                                Bands="@GetCanvasRoundBands()"
                                SaveRoundsRequested="SaveCanvasRoundsAsync">
                <div @ref="graphSurfaceRef"
                     class="template-graph-surface @(!allowLayoutDrag ? "template-graph-surface-layout-locked" : string.Empty)"
                     style="@SurfaceStyle">
                    <svg class="template-graph-edges"
                         width="@surfaceWidth"
                         height="@surfaceHeight"
                         xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="template-edge-winner"
                                    markerWidth="8"
                                    markerHeight="8"
                                    refX="7"
                                    refY="4"
                                    orient="auto"
                                    markerUnits="strokeWidth">
                                <path d="M0,0 L8,4 L0,8 Z" fill="var(--mud-palette-success)" />
                            </marker>
                            <marker id="template-edge-loser"
                                    markerWidth="8"
                                    markerHeight="8"
                                    refX="7"
                                    refY="4"
                                    orient="auto"
                                    markerUnits="strokeWidth">
                                <path d="M0,0 L8,4 L0,8 Z" fill="var(--mud-palette-warning)" />
                            </marker>
                        </defs>
                        @foreach (TournamentMatchFeed feed in graph.Feeds)
                        {
                            (double x1, double y1) = GetSourceAnchor(feed.SourceTournamentMatchId);
                            (double x2, double y2) = GetSlotAnchor(feed.TargetTournamentMatchId, feed.TargetSlot);
                            bool isWinner = feed.SourceOutcome == TemplateFeedOutcome.Winner;
                            string strokeColor = isWinner
                                ? "var(--mud-palette-success)"
                                : "var(--mud-palette-warning)";
                            string markerEnd = isWinner
                                ? "url(#template-edge-winner)"
                                : "url(#template-edge-loser)";
                            <line x1="@x1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  y1="@y1.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  x2="@x2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  y2="@y2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                  stroke="@strokeColor"
                                  stroke-width="2.5"
                                  marker-end="@markerEnd" />
                        }
                    </svg>
                    @foreach (TournamentMatch match in graph.Matches)
                    {
                        bool isDragging = draggingMatchId == match.TournamentMatchId;
                        if (isDragging)
                        {
                            <div class="template-match-box template-match-box-ghost"
                                 style="@GetBoxStyle(match.PositionX, match.PositionY)">
                                <div class="template-match-drag-handle">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    <div class="template-match-box-header">
                                        <MudText Typo="Typo.subtitle2">@DisplayName(match)</MudText>
                                        @if (match.PlayMode == TournamentMatchPlayMode.Online)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">Online</MudChip>
                                        }
                                    </div>
                                </div>
                                <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.A)">A: @FormatSlot(match, TemplateMatchSlot.A)</MudText>
                                <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.B)">B: @FormatSlot(match, TemplateMatchSlot.B)</MudText>
                            </div>
                        }
                        int displayX = isDragging ? dragCellX : match.PositionX;
                        int displayY = isDragging ? dragCellY : match.PositionY;
                        <div class="template-match-box @GetMatchStatusClass(match) @(selectedMatchId == match.TournamentMatchId ? "selected" : string.Empty) @(isDragging ? "dragging" : string.Empty)"
                             data-match-id="@match.TournamentMatchId"
                             style="@GetBoxStyle(displayX, displayY)"
                             @onpointerdown="@(async _ => await SelectMatchAsync(match))"
                             @onpointerdown:stopPropagation="true">
                            <div class="template-match-drag-handle">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                <div class="template-match-box-header">
                                    <MudText Typo="Typo.subtitle2">@DisplayName(match)</MudText>
                                    @if (match.PlayMode == TournamentMatchPlayMode.Online)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Online</MudChip>
                                    }
                                </div>
                            </div>
                            <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.A)">A: @FormatSlot(match, TemplateMatchSlot.A)</MudText>
                            <MudText Typo="Typo.caption" Class="@GetSlotLineClass(match, TemplateMatchSlot.B)">B: @FormatSlot(match, TemplateMatchSlot.B)</MudText>
                        </div>
                    }
                </div>
            </BracketRoundCanvas>
        </div>
        <MudTextField @bind-Value="editFormatDescription"
                      Label="Format"
                      Variant="Variant.Outlined"
                      Lines="6"
                      MaxLength="4000"
                      Class="format-description-field mt-4"
                      Immediate="true"
                      OnBlur="OnFormatDescriptionBlurAsync" />
    }
</MudStack>

<style>
    .template-graph-surface {
        position: relative;
        box-sizing: content-box;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
        background-color: var(--mud-palette-background-gray);
        background-image:
            linear-gradient(to right, color-mix(in srgb, var(--mud-palette-lines-default) 35%, transparent) 1px, transparent 1px),
            linear-gradient(to bottom, color-mix(in srgb, var(--mud-palette-lines-default) 35%, transparent) 1px, transparent 1px);
        background-size: 40px 40px;
        overflow: clip;
        align-self: flex-start;
    }

    .template-graph-surface-dragging .template-match-box:not(.template-match-box-ghost) {
        pointer-events: none;
    }

    .template-graph-surface-dragging .template-match-drag-handle {
        cursor: grabbing;
    }

    .template-graph-edges {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .template-match-box {
        position: absolute;
        width: 168px;
        padding: 4px 8px 8px;
        border-radius: 4px;
        border: 2px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
        cursor: pointer;
        user-select: none;
        z-index: 1;
    }

    .template-match-box.selected {
        border-color: var(--mud-palette-primary);
    }

    .template-match-box.dragging {
        z-index: 2;
        box-shadow: 0 4px 12px color-mix(in srgb, var(--mud-palette-text-primary) 25%, transparent);
    }

    .template-match-box-ghost {
        opacity: 0.35;
        border-style: dashed;
        pointer-events: none;
        z-index: 0;
        cursor: default;
    }

    .template-match-drag-handle {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 44px;
        margin: -4px -8px 4px;
        padding: 4px 8px 0;
        cursor: grab;
        touch-action: none;
    }

    .template-graph-surface-layout-locked .template-match-drag-handle {
        cursor: default;
        touch-action: auto;
        pointer-events: none;
    }

    .slot-line {
        display: block;
        line-height: 1.3;
    }
</style>

@code {
    private const int CellSize = 40;
    private const int BoxOffset = 6;
    private const int BoxWidth = 168;
    private const int BoxHeight = 88;
    private static readonly DialogOptions matchEditorDialogOptions = new()
    {
        CloseButton = false,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
        BackdropClick = false,
        CloseOnEscapeKey = false,
    };
    private int editGraphWidthCells;
    private int editGraphHeightCells;
    private string editFormatDescription = string.Empty;
    private Task saveFormatDescriptionQueue = Task.CompletedTask;
    [Parameter]
    public int TournamentId { get; set; }
    private TournamentBracketGraph? graph;
    private BracketRoundCanvas? bracketRoundCanvasRef;
    private int? selectedMatchId;
    private IReadOnlyList<TournamentTemplate> templates = [];
    private int? selectedTemplateId;
    private string pageTitle = "Tournament";
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private int? draggingMatchId;
    private int dragCellX;
    private int dragCellY;
    private ElementReference graphSurfaceRef;
    private bool allowLayoutDrag;
    private DotNetObjectReference<BracketMatchDragJsCallbacks>? matchDragDotNetRef;
    private BracketMatchDragJsCallbacks? matchDragCallbacks;
    private string? matchDragConfigKey;
    private bool matchDragInteropPending;
    private bool matchDragMoveRenderPending;
    private Task matchDragSaveQueue = Task.CompletedTask;
    protected override async Task OnParametersSetAsync()
    {
        templates = await TemplateStore.ListAsync(CancellationToken.None);
        await LoadGraphAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!JsInteropTiming.IsJsAvailable(RendererInfo.IsInteractive))
        {
            matchDragInteropPending = true;
            return;
        }

        if (matchDragInteropPending)
        {
            matchDragInteropPending = false;
        }

        await SyncMatchDragInteropAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await JsInteropTiming.TryInvokeVoidAsync(
            Js,
            RendererInfo.IsInteractive,
            "xwingTheme.disposeMatchDrag",
            graphSurfaceRef);

        matchDragDotNetRef?.Dispose();
    }

    private async Task LoadGraphAsync()
    {
        Result<TournamentBracketGraph> result = await BracketStore.GetGraphAsync(TournamentId, CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Template not found.", Severity.Error);
            graph = null;
            return;
        }
        graph = result.Value!;
        matchDragConfigKey = null;
        pageTitle = graph.Tournament.Name;
        selectedTemplateId = graph.Tournament.TournamentTemplateId;
        editGraphWidthCells = graph.Tournament.GraphWidthCells;
        editGraphHeightCells = graph.Tournament.GraphHeightCells;
        editFormatDescription = graph.Tournament.FormatDescription ?? string.Empty;
        if (selectedMatchId is int id && graph.Matches.All(m => m.TournamentMatchId != id))
        {
            selectedMatchId = null;
        }
    }

    private IReadOnlyList<BracketRoundBandView> GetCanvasRoundBands() =>
        graph?.CanvasRounds.Select(r => new BracketRoundBandView(r.WidthCells, r.Scenario)).ToList()
        ?? [];

    private async Task SaveCanvasRoundsAsync(IReadOnlyList<CanvasRoundInput> rounds)
    {
        if (graph is null)
        {
            return;
        }

        Result<Tournament> result = await BracketStore.UpdateRoundsAsync(
            TournamentId,
            rounds,
            graph.Tournament.RowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not save rounds.", Severity.Error);
            return;
        }

        await LoadGraphAsync();
    }

    private int surfaceWidth => graph is null
        ? BracketGraphLayout.ToSurfacePixels(BracketGraphLayout.DefaultGraphWidthCells)
        : BracketGraphLayout.ToSurfacePixels(graph.Tournament.GraphWidthCells);
    private int surfaceHeight => graph is null
        ? BracketGraphLayout.ToSurfacePixels(BracketGraphLayout.DefaultGraphHeightCells)
        : BracketGraphLayout.ToSurfacePixels(graph.Tournament.GraphHeightCells);
    private string SurfaceStyle => $"width: {surfaceWidth}px; height: {surfaceHeight}px; max-width: {surfaceWidth}px;";
    private int GetCellX(TournamentMatch match) =>
        draggingMatchId == match.TournamentMatchId ? dragCellX : match.PositionX;
    private int GetCellY(TournamentMatch match) =>
        draggingMatchId == match.TournamentMatchId ? dragCellY : match.PositionY;
    private static string GetBoxStyle(int cellX, int cellY) =>
        $"left: {cellX * CellSize + BoxOffset}px; top: {cellY * CellSize + BoxOffset}px;";
    private async Task SelectMatchAsync(TournamentMatch match)
    {
        if (draggingMatchId is not null)
        {
            return;
        }

        selectedMatchId = match.TournamentMatchId;
        await OpenMatchEditorDialogAsync(match.TournamentMatchId);
    }

    private async Task OpenMatchEditorDialogAsync(int tournamentMatchId)
    {
        var parameters = new DialogParameters<TournamentMatchEditorDialog>
        {
            { x => x.TournamentId, TournamentId },
            { x => x.TournamentMatchId, tournamentMatchId },
        };
        IDialogReference dialog = await DialogService.ShowAsync<TournamentMatchEditorDialog>(
            null,
            parameters,
            matchEditorDialogOptions);
        DialogResult? result = await dialog.Result;
        await LoadGraphAsync();
        if (result?.Data is true)
        {
            selectedMatchId = null;
            return;
        }

        selectedMatchId = graph?.Matches.Any(m => m.TournamentMatchId == tournamentMatchId) == true
            ? tournamentMatchId
            : null;
    }

    private async Task OnTemplateSelectedAsync(int? templateId)
    {
        if (templateId is null)
        {
            selectedTemplateId = null;
            return;
        }

        if (graph?.Matches.Count > 0)
        {
            IDialogReference dialog = await DialogService.ShowAsync<ReplaceBracketConfirmDialog>();
            DialogResult? dialogResult = await dialog.Result;
            if (dialogResult is null || dialogResult.Canceled)
            {
                selectedTemplateId = graph?.Tournament.TournamentTemplateId;
                return;
            }
        }

        Result result = await BracketStore.AssignTemplateAsync(TournamentId, templateId.Value, CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not apply template.", Severity.Error);
            selectedTemplateId = graph?.Tournament.TournamentTemplateId;
            return;
        }

        selectedTemplateId = templateId;
        selectedMatchId = null;
        ShowStatus("Template applied.", Severity.Success);
        await LoadGraphAsync();
    }

    private Task saveGraphSizeQueue = Task.CompletedTask;
    private Task SaveGraphSizeAsync()
    {
        saveGraphSizeQueue = SaveNextGraphSizeAsync(saveGraphSizeQueue);
        return saveGraphSizeQueue;
    }

    private async Task SaveNextGraphSizeAsync(Task previous)
    {
        try
        {
            await previous;
        }
        catch (Exception)
        {
            // The previous attempt already reported its own error.
        }

        if (graph is null
            || (editGraphWidthCells == graph.Tournament.GraphWidthCells
                && editGraphHeightCells == graph.Tournament.GraphHeightCells))
        {
            return;
        }

        int widthCells = editGraphWidthCells;
        int heightCells = editGraphHeightCells;
        int previousWidthCells = graph.Tournament.GraphWidthCells;
        int previousHeightCells = graph.Tournament.GraphHeightCells;
        byte[] rowVersion = graph.Tournament.RowVersion;
        int[]? previousRoundWidths = null;
        if (widthCells != previousWidthCells && graph.CanvasRounds.Count > 0)
        {
            previousRoundWidths = graph.CanvasRounds.Select(r => r.WidthCells).ToArray();
            Result<List<int>> adjusted = BracketRoundLayout.TryAdjustForCanvasWidthChange(
                previousRoundWidths,
                widthCells);
            if (!adjusted.IsSuccess)
            {
                editGraphWidthCells = previousWidthCells;
                ShowStatus(adjusted.Error ?? "Could not resize round columns.", Severity.Error);
                return;
            }

            for (int i = 0; i < graph.CanvasRounds.Count; i++)
            {
                graph.CanvasRounds[i].WidthCells = adjusted.Value![i];
            }
        }

        graph.Tournament.GraphWidthCells = widthCells;
        graph.Tournament.GraphHeightCells = heightCells;
        await InvokeAsync(StateHasChanged);
        Result<Tournament> result = await BracketStore.UpdateGraphSizeAsync(
            TournamentId,
            widthCells,
            heightCells,
            rowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            graph.Tournament.GraphWidthCells = previousWidthCells;
            graph.Tournament.GraphHeightCells = previousHeightCells;
            editGraphWidthCells = previousWidthCells;
            editGraphHeightCells = previousHeightCells;
            if (previousRoundWidths is not null)
            {
                for (int i = 0; i < graph.CanvasRounds.Count; i++)
                {
                    graph.CanvasRounds[i].WidthCells = previousRoundWidths[i];
                }
            }

            ShowStatus(result.Error ?? "Could not save canvas size.", Severity.Error);
            return;
        }

        await LoadGraphAsync();
        if (statusSeverity == Severity.Error)
        {
            statusMessage = null;
        }
    }

    private Task OnFormatDescriptionBlurAsync()
    {
        saveFormatDescriptionQueue = SaveNextFormatDescriptionAsync(saveFormatDescriptionQueue);
        return saveFormatDescriptionQueue;
    }

    private async Task SaveNextFormatDescriptionAsync(Task previous)
    {
        try
        {
            await previous;
        }
        catch (Exception)
        {
            // The previous attempt already reported its own error.
        }

        if (graph is null)
        {
            return;
        }

        string? normalizedEdit = NormalizeFormatDescription(editFormatDescription);
        string? stored = graph.Tournament.FormatDescription;
        if (normalizedEdit == stored)
        {
            return;
        }

        string? previousStored = stored;
        byte[] rowVersion = graph.Tournament.RowVersion;
        graph.Tournament.FormatDescription = normalizedEdit;
        Result<Tournament> result = await BracketStore.UpdateFormatDescriptionAsync(
            TournamentId,
            editFormatDescription,
            rowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            graph.Tournament.FormatDescription = previousStored;
            editFormatDescription = previousStored ?? string.Empty;
            ShowStatus(result.Error ?? "Could not save format.", Severity.Error);
            return;
        }

        graph.Tournament.RowVersion = result.Value!.RowVersion;
        graph.Tournament.FormatDescription = result.Value.FormatDescription;
        editFormatDescription = result.Value.FormatDescription ?? string.Empty;
        if (statusSeverity == Severity.Error)
        {
            statusMessage = null;
        }
    }

    private static string? NormalizeFormatDescription(string? text) =>
        string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private static string DisplayName(TournamentMatch match) =>
        string.IsNullOrWhiteSpace(match.Name) ? $"Match {match.TournamentMatchId}" : match.Name!;

    private string FormatSlot(TournamentMatch match, TemplateMatchSlot slot)
    {
        int? userId = slot == TemplateMatchSlot.A ? match.SlotAUserId : match.SlotBUserId;
        int? points = slot == TemplateMatchSlot.A ? match.SlotAPoints : match.SlotBPoints;
        if (userId is int uid)
        {
            string name = graph!.Participants.FirstOrDefault(p => p.UserId == uid)?.UserName ?? $"User {uid}";
            string pointsText = points is int p ? $" ({p} pts)" : string.Empty;
            return $"{name}{pointsText}";
        }

        TournamentMatchFeed? feed = graph!.Feeds.SingleOrDefault(
            f => f.TargetTournamentMatchId == match.TournamentMatchId && f.TargetSlot == slot);
        if (feed is null)
        {
            string? label = slot == TemplateMatchSlot.A ? match.SlotAOpenLabel : match.SlotBOpenLabel;
            return string.IsNullOrWhiteSpace(label) ? "-" : label;
        }
        TournamentMatch? source = graph.Matches.SingleOrDefault(m => m.TournamentMatchId == feed.SourceTournamentMatchId);
        string sourceName = source is null ? "?" : DisplayName(source);
        return feed.SourceOutcome == TemplateFeedOutcome.Winner
            ? $"Winner of {sourceName}"
            : $"Loser of {sourceName}";
    }

    private string GetSlotLineClass(TournamentMatch match, TemplateMatchSlot slot)
    {
        const string baseClass = "slot-line";
        if (match.Winner == TournamentMatchWinner.SlotA && slot == TemplateMatchSlot.A)
        {
            return $"{baseClass} slot-outcome-winner";
        }

        if (match.Winner == TournamentMatchWinner.SlotB && slot == TemplateMatchSlot.B)
        {
            return $"{baseClass} slot-outcome-winner";
        }

        if (match.Winner == TournamentMatchWinner.SlotA && slot == TemplateMatchSlot.B)
        {
            return $"{baseClass} slot-outcome-loser";
        }

        if (match.Winner == TournamentMatchWinner.SlotB && slot == TemplateMatchSlot.A)
        {
            return $"{baseClass} slot-outcome-loser";
        }

        TournamentMatchFeed? feed = graph!.Feeds.SingleOrDefault(
            f => f.TargetTournamentMatchId == match.TournamentMatchId && f.TargetSlot == slot);
        if (feed is null)
        {
            return baseClass;
        }

        return feed.SourceOutcome == TemplateFeedOutcome.Winner
            ? $"{baseClass} slot-outcome-winner"
            : $"{baseClass} slot-outcome-loser";
    }

    private static string GetMatchStatusClass(TournamentMatch match) =>
        match.Status switch
        {
            TournamentMatchStatus.InProgress => "match-status-in-progress",
            TournamentMatchStatus.Finished => "match-status-finished",
            _ => string.Empty,
        };

    private (double X, double Y) GetSourceAnchor(int sourceMatchId)
    {
        TournamentMatch match = graph!.Matches.Single(m => m.TournamentMatchId == sourceMatchId);
        double left = GetCellX(match) * CellSize + BoxOffset;
        double top = GetCellY(match) * CellSize + BoxOffset;
        return (left + BoxWidth, top + BoxHeight / 2);
    }

    private (double X, double Y) GetSlotAnchor(int targetMatchId, TemplateMatchSlot slot)
    {
        TournamentMatch match = graph!.Matches.Single(m => m.TournamentMatchId == targetMatchId);
        double left = GetCellX(match) * CellSize + BoxOffset;
        double top = GetCellY(match) * CellSize + BoxOffset;
        double slotY = slot == TemplateMatchSlot.A ? top + 28 : top + 56;
        return (left, slotY);
    }

    private async Task OnAllowLayoutDragChangedAsync()
    {
        if (!allowLayoutDrag)
        {
            draggingMatchId = null;
        }

        matchDragConfigKey = null;
        matchDragInteropPending = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncMatchDragInteropAsync()
    {
        if (graph is null || !JsInteropTiming.IsJsAvailable(RendererInfo.IsInteractive))
        {
            if (graph is not null)
            {
                matchDragInteropPending = true;
            }

            return;
        }

        if (draggingMatchId is not null)
        {
            matchDragInteropPending = true;
            return;
        }

        if (!allowLayoutDrag)
        {
            if (matchDragConfigKey is not null)
            {
                if (!await TryDisposeMatchDragAsync())
                {
                    return;
                }

                matchDragConfigKey = null;
            }

            return;
        }

        string configKey = $"{graph.Tournament.GraphWidthCells}:{graph.Tournament.GraphHeightCells}";
        if (configKey == matchDragConfigKey)
        {
            return;
        }

        matchDragCallbacks ??= new BracketMatchDragJsCallbacks(
            OnMatchDragStarted,
            OnMatchDragMoved,
            OnMatchDragEndedAsync);
        matchDragDotNetRef ??= DotNetObjectReference.Create(matchDragCallbacks);

        int maxX = BracketGraphLayout.MaxMatchPositionX(graph.Tournament.GraphWidthCells);
        int maxY = BracketGraphLayout.MaxMatchPositionY(graph.Tournament.GraphHeightCells);
        if (await JsInteropTiming.TryInvokeVoidAsync(
            Js,
            RendererInfo.IsInteractive,
            "xwingTheme.attachMatchDrag",
            graphSurfaceRef,
            matchDragDotNetRef,
            new
            {
                cellSize = BracketGraphLayout.CellSize,
                boxOffset = BracketGraphLayout.BoxOffset,
                maxX,
                maxY,
            }))
        {
            matchDragConfigKey = configKey;
        }
        else
        {
            matchDragInteropPending = true;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> TryDisposeMatchDragAsync()
    {
        if (await JsInteropTiming.TryInvokeVoidAsync(
            Js,
            RendererInfo.IsInteractive,
            "xwingTheme.disposeMatchDrag",
            graphSurfaceRef))
        {
            return true;
        }

        matchDragInteropPending = true;
        _ = InvokeAsync(StateHasChanged);
        return false;
    }

    private void OnMatchDragStarted(int matchId, int cellX, int cellY)
    {
        draggingMatchId = matchId;
        dragCellX = cellX;
        dragCellY = cellY;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMatchDragMoved(int matchId, int cellX, int cellY)
    {
        if (draggingMatchId != matchId)
        {
            return;
        }

        dragCellX = cellX;
        dragCellY = cellY;
        if (matchDragMoveRenderPending)
        {
            return;
        }

        matchDragMoveRenderPending = true;
        _ = InvokeAsync(() =>
        {
            matchDragMoveRenderPending = false;
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    private Task OnMatchDragEndedAsync(int matchId, int cellX, int cellY)
    {
        TournamentMatch? match = graph?.Matches.SingleOrDefault(m => m.TournamentMatchId == matchId);
        draggingMatchId = null;
        if (match is null)
        {
            return InvokeAsync(StateHasChanged);
        }

        if (match.PositionX == cellX && match.PositionY == cellY)
        {
            return InvokeAsync(StateHasChanged);
        }

        matchDragSaveQueue = SaveNextMatchDragAsync(matchDragSaveQueue, matchId, cellX, cellY);
        return matchDragSaveQueue;
    }

    private async Task SaveNextMatchDragAsync(Task previous, int matchId, int cellX, int cellY)
    {
        try
        {
            await previous;
        }
        catch (Exception)
        {
            // Prior save already reported its error.
        }

        if (graph is null)
        {
            return;
        }

        TournamentMatch? match = graph.Matches.SingleOrDefault(m => m.TournamentMatchId == matchId);
        if (match is null)
        {
            return;
        }

        if (match.PositionX == cellX && match.PositionY == cellY)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        Result<TournamentMatch> result = await BracketStore.UpdateMatchPositionAsync(
            match.TournamentMatchId,
            cellX,
            cellY,
            match.RowVersion,
            CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not save position.", Severity.Error);
            await InvokeAsync(StateHasChanged);
            return;
        }

        TournamentMatch saved = result.Value!;
        match.PositionX = saved.PositionX;
        match.PositionY = saved.PositionY;
        match.RowVersion = saved.RowVersion;
        await InvokeAsync(StateHasChanged);
    }

    private Task AddRoundAsync() =>
        bracketRoundCanvasRef?.AddRoundAsync() ?? Task.CompletedTask;

    private async Task AddMatchAsync()
    {
        Result<TournamentMatch> result = await BracketStore.AddMatchAsync(TournamentId, CancellationToken.None);
        if (!result.IsSuccess)
        {
            ShowStatus(result.Error ?? "Could not add match.", Severity.Error);
            return;
        }
        int newMatchId = result.Value!.TournamentMatchId;
        await LoadGraphAsync();
        await OpenMatchEditorDialogAsync(newMatchId);
    }

    private void ShowStatus(string message, Severity severity)
    {
        statusMessage = message;
        statusSeverity = severity;
    }

}
